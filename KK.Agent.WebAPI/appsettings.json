{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Provider": {
    "Model": "<MODEL>",
    "ApiKey": "<APIKEY>",
    "Endpoint": "<ENDPOINT>"
  },
  "ConfigAgentsHub": {
    "ApiKey": "<ApiKey>"
  },
  "AllowedHosts": "*",
  "McpServers": [
    {
      "Name": "filesystem",
      "Command": "dotnet",
      "Arguments": "run --project Mcp.FileSystem"
    }
  ]
}
